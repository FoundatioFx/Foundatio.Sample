<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="foundatio" value="https://f.feedz.io/foundatio/foundatio/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Foundatio" />
      <package pattern="Foundatio.*" />
    </packageSource>
    <packageSource key="foundatio">
      <package pattern="Foundatio" />
      <package pattern="Foundatio.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
